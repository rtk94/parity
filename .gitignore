# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Environments / secrets
.env
.env.local
.env.*.local

# Flask
instance/
*.db
*.sqlite
*.sqlite3

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/
coverage.xml
*.cover

# Ruff / mypy
.ruff_cache/
.mypy_cache/

# Editors
# Both slash and slash-less forms: these are normally directories, but a
# containerised dev environment may mount them as single files, and a
# trailing-slash pattern only matches a directory.
.idea/
.idea
.vscode/
.vscode
*.swp
*.swo
.DS_Store

# Claude Code
.claude/settings.local.json
.claude/transcripts/
.claude/plans/
.claude/memory/cache/
# Per-machine agent configuration. Only .claude/settings.json is shared;
# everything else under .claude/ is local to whoever is running the agent.
.claude/agents
.claude/commands
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/scheduled_tasks.json
.claude/skills
.claude/workflows
.claude/.cc-writes
# Only the repo-root .claude/ is shared. An agent running with a subdirectory
# as its working directory synthesises its own config dir there; none of those
# belong to the project.
/*/.claude/
/*/*/.claude/

# Per-user shell, tool, and VCS config. These belong to a developer's home
# directory, never to the project — but a containerised dev environment can
# surface them inside the working tree, where an untracked entry is one
# careless `git add -A` away from being committed.
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.ripgreprc
.mcp.json
# Deliberately NOT ignoring .gitmodules, even though a sandbox may surface one
# here: a real .gitmodules belongs in version control, and ignoring it would
# quietly break `git submodule add`.

# Additional common files
*.log
*.pid
.env.production
.env.staging
.env.test

# Push / Firebase credentials (service-account keys — never commit)
*firebase-adminsdk*.json
*-service-account*.json
# Real per-environment Firebase app configs are ignored; the structurally
# valid placeholder at android/app/google-services.json IS committed so CI
# and fresh clones can build (real src/{debug,release} files override it).
google-services.json
!/android/app/google-services.json

# Android
.gradle/
android/.gradle/
android/local.properties
# Repo-local SDK, used by scripts/bootstrap-dev.sh when $HOME is unwritable.
.android-sdk/
android/**/build/
android/**/*.iml
android/captures/

# Release signing material — the upload key and its password. Losing these
# means you can no longer ship updates under the same upload key (Play App
# Signing allows a reset, but it is a manual, slow process). Back them up
# offline; never commit them.
android/upload-keystore.jks
android/keystore.properties
*.jks
*.keystore
android/.kotlin/
*.apk
*.aab
*.hprof


# Local build artifacts staged for upload (AABs/APKs)
dist/
