{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Agent(*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "sandbox":{
    "network":{
      "allowedDomains":[
        "dl.google.com",
        "maven.google.com",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "oss.sonatype.org"
      ]
    }
  }
}
