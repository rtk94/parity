FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=<REPLACE_WITH_RANDOM_STRING>
DATABASE_URL=sqlite:///parity.db

# Push notifications (optional). Path to a Google service-account JSON
# with the Firebase Cloud Messaging API enabled. Leave unset to disable
# push (a no-op sender is used). Each environment points at its own
# project's file, e.g. /etc/parity/fcm-production.json (chmod 600).
# FCM_CREDENTIALS_FILE=

# Outbound email (REQUIRED for password reset — see
# docs/adr/0002-password-reset-transport.md). Provider-agnostic SMTP;
# the hosted instance uses Resend. Leave MAIL_SERVER unset only in dev:
# a no-op sender is used and reset codes are delivered nowhere, which
# makes account recovery silently impossible. Registration also sends a
# welcome email confirming the recovery address.
# MAIL_SERVER=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend                  # literal, for Resend
# MAIL_PASSWORD=re_xxxxxxxx             # API key, not an account password
# MAIL_USE_TLS=true
# MAIL_FROM=no-reply@parity.rknepp.com  # must be on the verified domain
# PASSWORD_RESET_LIFETIME_MINUTES=15
# PASSWORD_RESET_MAX_ATTEMPTS=5

# Attachment storage (optional; see docs/adr/0003-attachment-storage.md).
# Set ATTACHMENT_S3_BUCKET to store receipt files in S3-compatible object
# storage (S3, Cloudflare R2, or OCI Object Storage via the endpoint URL).
# Leave it unset to store files on the local filesystem (dev default:
# instance/attachments).
# ATTACHMENT_S3_BUCKET=parity-attachments
# ATTACHMENT_S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# ATTACHMENT_S3_REGION=us-ashburn-1
# ATTACHMENT_S3_ACCESS_KEY=
# ATTACHMENT_S3_SECRET_KEY=
# ATTACHMENT_LOCAL_DIR=
# ATTACHMENT_MAX_BYTES=10485760
